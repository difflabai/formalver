---------------------------- MODULE TraceCheck ----------------------------
(***************************************************************************)
(* REF-5, trace validation (strategy.md section 17.2). TraceData.tla holds *)
(* traces of the real core, generated by kani/src/trace.rs. TLC starts     *)
(* each one from Init and replays it step by step: a step is accepted only *)
(* if it is a step of ApprovalCore with the same error and post-state.     *)
(* A rejected step leaves no successor, which TLC reports as a deadlock,   *)
(* so CHECK_DEADLOCK is on and a finished trace stutters explicitly.       *)
(***************************************************************************)
EXTENDS ApprovalCore, TraceData, TLC

VARIABLES tr, pos

tvars == <<principals, requests, log, regs, revoked, ghost, tr, pos>>

\* The ghost is not in the traces; the actions maintain it as usual.
TInit == Init /\ tr \in 1 .. Len(Traces) /\ pos = 0

Post(e) ==
    /\ principals' = e.post.principals
    /\ requests' = e.post.requests
    /\ log' = e.post.log
    /\ regs' = e.post.regs
    /\ revoked' = e.post.revoked

\* A rejected call: the spec's error operator gives the core's error, and
\* the state does not change.
Refused(err, e) == err = e.err /\ e.err # "Ok" /\ UNCHANGED vars

Replay(e) ==
    CASE e.op = "add" ->
            IF e.err = "Ok" THEN AddPrincipal(e.c, e.k, e.a, e.r) ELSE Refused(AddErr(e.c, e.k), e)
      [] e.op = "revoke" ->
            IF e.err = "Ok" THEN RevokeKey(e.c, e.k) ELSE Refused(RevokeErr(e.c, e.k), e)
      [] e.op = "request" ->
            IF e.err = "Ok" THEN RequestAction(e.p, e.s, e.k, e.x)
            ELSE Refused(RequestErr(e.p, e.s, e.k, e.x), e)
      [] e.op = "approve" ->
            IF e.err = "Ok" THEN Approve(e.p, e.s, e.k, e.i, e.x)
            ELSE Refused(ApproveErr(e.p, e.s, e.k, e.i, e.x), e)
      [] e.op = "reject" ->
            IF e.err = "Ok" THEN Reject(e.p, e.s, e.k, e.i)
            ELSE Refused(RejectErr(e.p, e.s, e.k, e.i), e)

TNext ==
    \/ /\ pos < Len(Traces[tr])
       /\ Replay(Traces[tr][pos + 1])
       /\ Post(Traces[tr][pos + 1])
       /\ pos' = pos + 1
       /\ UNCHANGED tr
    \/ /\ pos = Len(Traces[tr])
       /\ UNCHANGED tvars

TSpec == TInit /\ [][TNext]_tvars /\ WF_tvars(TNext)

\* Every trace is replayed to its end (with deadlock checking, a rejected
\* step is already an error; this makes the goal explicit).
Done == <>(pos = Len(Traces[tr]))
=============================================================================
