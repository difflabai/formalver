# (E:134 dropped) stores a job for a forgotten id. Must be killed by
# InvJobWindow.
--- a/Executor.tla
+++ b/Executor.tla
@@ -238,7 +238,7 @@
 (* (E:136-141), then notify sends settle(id, false) (E:142).              *)
 Confirm(i) ==
     /\ i \notin DOMAIN jobs
