# checks: executor-w2-noview
# TLA-EXEC, FR-13 (revert): on_settled never advances (E:157-159 dropped),
# so an accepted confirmation above newest stays there with nothing left
# to raise newest past it. Must be killed by InvConfSettles (first, at the
# accepted settle's on_settled) or AdvanceOnVouch (StepExec).
--- a/Executor.tla
+++ b/Executor.tla
@@ -122,7 +122,7 @@
 (* E:153-160 on_settled(id): private, needs one promise result (E:155),   *)
 (* advance(id) unless the settle failed (E:157-159). As <<newest, jobs>>. *)
 Settled(i, ok) ==
-    IF ok THEN <<Max(newest, i), Keep(Max(newest, i))>> ELSE <<newest, jobs>>
+    IF FALSE THEN <<Max(newest, i), Keep(Max(newest, i))>> ELSE <<newest, jobs>>
 
 (* The ghost made keeps only ids at or above firstId.                     *)
 Made(i) == IF i >= firstId THEN made \cup {i} ELSE made
