-            /\ SetStatus(id, "Completed")
-            /\ doneU' = [doneU EXCEPT ![Rec(id).recipe + 1] = Min(@ + Rec(id).units, DoneCap)]
-            /\ version' = version + 1
-            /\ UNCHANGED <<cfg, observedAt, paused, firstId, base, k0>>
-       ELSE Release(id)
-    /\ Step("settle", c, id, Rec(id).recipe, Rec(id).units, 0, done, 0, 0)
+       THEN UNCHANGED vars
+       ELSE /\ Release(id)
+            /\ Step("settle", c, id, Rec(id).recipe, Rec(id).units, 0, done, 0, 0)
 
 SetPaused(c, b) ==
     /\ PauseErr(c, b) = "Ok"
