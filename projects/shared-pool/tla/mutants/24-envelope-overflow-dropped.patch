# checks: Witness_F2bRefused trace
# The envelope's endpoint check (Arithmetic) is dropped. An endpoint
# beyond +-1e6 then fails Bounds instead (it exceeds every violation the
# comparator allows), so the reachable states are the same: only the
# error name differs, which Witness_F2bRefused and the traces (206, 208)
# see.
--- a/SharedPool.tla
+++ b/SharedPool.tla
@@ -209,7 +209,7 @@
 CheckBounds(cand, er, eu, skip) ==
     LET lo == [m \in MIdx |-> Low(cand, er, eu, skip, m)]
         hi == [m \in MIdx |-> High(cand, er, eu, skip, m)]
-    IN IF \E m \in MIdx : ~Bounded(lo[m]) \/ ~Bounded(hi[m]) THEN "Arithmetic"
+    IN IF FALSE THEN "Arithmetic"
        ELSE IF \E m \in MIdx :
                  Max0(Mn(m) - lo[m]) + Max0(hi[m] - Mx(m)) > Min(PV(values, m), PV(cand, m))
             THEN "Bounds"
