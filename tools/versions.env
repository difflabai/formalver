# Tool pins (strategy.md section 11). Sourced by CI and the run-* scripts.
# Empty values are pinned by the milestone that first needs the tool.

# Plain-mode tests (stable toolchain).
RUST_TOOLCHAIN=1.97.0

# Kani and the CBMC it requires (kani-dependencies at the tag).
# Kani 0.68.0 builds against nightly-2026-08-21 (its rust-toolchain.toml).
KANI=0.68.0
CBMC=6.11.0

VERUS=
SCRYER=
CARGO_NEAR=
NEAR_SANDBOX=
