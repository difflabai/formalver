# Tool pins (strategy.md section 11). Sourced by CI and the run-* scripts.
# Empty values are pinned by the milestone that first needs the tool.

# Plain-mode tests (stable toolchain).
RUST_TOOLCHAIN=1.97.0

# Kani and the CBMC it requires (kani-dependencies at the tag).
# Kani 0.68.0 builds against nightly-2026-08-21 (its rust-toolchain.toml).
KANI=0.68.0
CBMC=6.11.0

# TLA+ (strategy.md section 17): TLC and Apalache, from GitHub releases.
# Java 17 or later (Apalache needs it). TLC is the last stable release:
# the v1.8.0 release asset is a rolling build that changes under the same
# URL, so a sha256 pin on it breaks.
TLA2TOOLS=1.7.4
TLA2TOOLS_SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
APALACHE=0.47.2
APALACHE_SHA256=de2e8ae4cbb38d74bd329cb77e6433289f2a149d1e6d2cbc51055a8ca80b2fb4

# Verus (M5, strategy.md section 7): the weekly release (not a rolling one),
# from GitHub releases; it names the rustup toolchain it needs.
VERUS=0.2026.10.04.426d8b0
VERUS_RUST_TOOLCHAIN=1.98.1
VERUS_LINUX_SHA256=624018662868563a7bec0dd07be5e4dd0c3d61124b4b55105765884bf2d4d1a0
VERUS_DARWIN_AARCH64_SHA256=83cafc50284caea07fa8762df04b00cc0af441f25cdf1631d6c30987c65af446
# Prolog (M4): scryer-prolog from crates.io (cargo install --locked).
SCRYER=0.10.0
# cargo-near (M3 near-unit, M6 sandbox): the release the upstream reproducible
# image uses (sourcescan/cargo-near:0.22.0-rust-1.97.0). Release tarballs from
# GitHub, sha256-checked by get-cargo-near.sh (same hashes as trust-framework's
# approval-contract workflow).
CARGO_NEAR=0.22.0
CARGO_NEAR_LINUX_SHA256=9429064e30a427e96523f539cb255f3688d2345e5000d7d4e4873a8247247d1a
CARGO_NEAR_DARWIN_AARCH64_SHA256=55bd219c28c6996512a7c3836519f160b27b73a723f087634bf16f8a0bd48c8a
# near-sandbox (M6): the default of near-workspaces 0.23.0 / near-sandbox
# 0.3.16, downloaded by near-workspaces on first use.
NEAR_SANDBOX=2.13.4

# Lean 4 (strategy.md section 18): the toolchain release, no elan. Must match
# projects/near-approval/lean/lean-toolchain (near-proof-arena's pin).
LEAN=4.34.1
LEAN_LINUX_SHA256=3013aba02bb8bf31b1cf8c9d956d60fb95bb1c10920dfe91abcaa59cb461ddac
LEAN_DARWIN_AARCH64_SHA256=9019fcd34e93fddf0ecf9d40d28f05a86ba563ac3b701a9c5116ce1c96379360
