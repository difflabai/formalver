# Tool pins (strategy.md section 11). Sourced by CI and the run-* scripts.
# Empty values are pinned by the milestone that first needs the tool.

# Plain-mode tests (stable toolchain).
RUST_TOOLCHAIN=1.97.0

# Kani and the CBMC it requires (kani-dependencies at the tag).
# Kani 0.68.0 builds against nightly-2026-08-21 (its rust-toolchain.toml).
KANI=0.68.0
CBMC=6.11.0

# TLA+ (strategy.md section 17): TLC and Apalache, from GitHub releases.
# Both need Java 17 or later.
TLA2TOOLS=1.8.0
TLA2TOOLS_SHA256=7beec0f04818732a62fa193731711a99aa4f11279499b2360a7d156c519ea78d
APALACHE=0.47.2
APALACHE_SHA256=de2e8ae4cbb38d74bd329cb77e6433289f2a149d1e6d2cbc51055a8ca80b2fb4

VERUS=
# Prolog (M4): scryer-prolog from crates.io (cargo install --locked).
SCRYER=0.10.0
CARGO_NEAR=
NEAR_SANDBOX=

# Lean 4 (strategy.md section 18): the toolchain release, no elan. Must match
# projects/near-approval/lean/lean-toolchain (near-proof-arena's pin).
LEAN=4.34.1
LEAN_LINUX_SHA256=3013aba02bb8bf31b1cf8c9d956d60fb95bb1c10920dfe91abcaa59cb461ddac
LEAN_DARWIN_AARCH64_SHA256=9019fcd34e93fddf0ecf9d40d28f05a86ba563ac3b701a9c5116ce1c96379360
